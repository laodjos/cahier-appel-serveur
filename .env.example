# --- Serveur ---
PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173

# --- Base de données PostgreSQL ---
DATABASE_URL=postgres://cahier_appel:motdepasse@localhost:5432/cahier_appel

# --- Authentification ---
JWT_SECRET=change_moi_avec_une_valeur_longue_et_aleatoire
JWT_EXPIRES_IN=12h

# --- Lecteur ZKTeco (entrée établissement) ---
# Plusieurs lecteurs possibles : dupliquer ces 3 lignes avec un suffixe _2, _3, etc.
ZKTECO_1_NAME=ZKTeco - Portail Nord
ZKTECO_1_IP=192.168.1.201
ZKTECO_1_PORT=4370
ZKTECO_POLL_INTERVAL_SECONDS=15

# --- Lecteur Hikvision (entrée établissement) ---
HIKVISION_1_NAME=Hikvision - Portail Sud
HIKVISION_1_IP=192.168.1.202
HIKVISION_1_USER=admin
HIKVISION_1_PASSWORD=change_moi
HIKVISION_1_PORT=80

# --- Notifications (appli mobile parents) ---
# Choisir un fournisseur : "expo" (Expo Push, simple pour React Native) ou "fcm" (Firebase Cloud Messaging)
NOTIFICATION_PROVIDER=expo
FCM_SERVICE_ACCOUNT_JSON_PATH=./firebase-service-account.json

# --- QR code des badges élèves ---
QR_SECRET=change_moi_aussi_valeur_longue_et_aleatoire
