# --- Serveur ---
PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173

# --- Base de données PostgreSQL ---
DATABASE_URL=postgres://cahier_appel:motdepasse@localhost:5432/cahier_appel

# --- Authentification ---
JWT_SECRET=change_moi_avec_une_valeur_longue_et_aleatoire
JWT_EXPIRES_IN=12h

# --- Lecteur ZKTeco (entrée établissement) ---
# Plusieurs lecteurs possibles : dupliquer ces 3 lignes avec un suffixe _2, _3, etc.
ZKTECO_1_NAME=ZKTeco - Portail Nord
ZKTECO_1_IP=192.168.1.201
ZKTECO_1_PORT=4370
ZKTECO_POLL_INTERVAL_SECONDS=15

# --- Lecteur Hikvision (entrée établissement) ---
HIKVISION_1_NAME=Hikvision - Portail Sud
HIKVISION_1_IP=192.168.1.202
HIKVISION_1_USER=admin
HIKVISION_1_PASSWORD=change_moi
HIKVISION_1_PORT=80

# --- Notifications (appli mobile parents) ---
# Choisir un fournisseur : "expo" (Expo Push, simple pour React Native) ou "fcm" (Firebase Cloud Messaging)
NOTIFICATION_PROVIDER=sms
FCM_SERVICE_ACCOUNT_JSON_PATH=./firebase-service-account.json

# Orange SMS API (Côte d'Ivoire) — https://developer.orange.com/apis/sms-ci
# ORANGE_SMS_AUTHORIZATION_HEADER : la valeur "Basic xxxxx" fournie sur la page
# de ton application, dans l'espace développeur Orange (bouton "Show").
# ORANGE_SMS_SENDER_NUMBER : ton numéro expéditeur Orange, sans "+" ni "00"
# (ex. 2250000000).
ORANGE_SMS_AUTHORIZATION_HEADER=
ORANGE_SMS_SENDER_NUMBER=

# CinetPay (paiement des renouvellements d'abonnement) — https://docs.cinetpay.com
# Couvre Wave, Orange Money, MTN MoMo et Moov Africa en une seule intégration.
# CINETPAY_API_KEY et CINETPAY_SITE_ID sont fournis dans ton tableau de bord
# CinetPay, une fois ton compte marchand validé.
# APP_BASE_URL : l'adresse publique de ton serveur (ex. https://cahier-appel-serveur.onrender.com),
# utilisée pour construire les adresses de retour/notification après paiement.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
APP_BASE_URL=

# Notifications web push (rappel "cours dans 15 min" aux enseignants, même
# application fermée) — génère une paire de clés UNIQUE à ton serveur avec :
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Ne réutilise JAMAIS une paire d'exemple trouvée en ligne — chaque déploiement
# doit avoir la sienne.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# --- QR code des badges élèves ---
QR_SECRET=change_moi_aussi_valeur_longue_et_aleatoire
